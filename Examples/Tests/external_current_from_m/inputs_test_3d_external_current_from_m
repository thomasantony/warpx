warpx.abort_on_warning_threshold = medium
warpx.serialize_initial_conditions = 1
warpx.do_dynamic_scheduling = 0
warpx.verbose = 0

max_step = 1
geometry.dims = 3
geometry.prob_lo = -4.0 -4.0 -4.0
geometry.prob_hi =  4.0  4.0  4.0
geometry.is_periodic = 0 0 0
amr.n_cell = 8 8 8
amr.max_grid_size = 4
amr.blocking_factor = 4
amr.max_level = 0

boundary.field_lo = pec pec pec
boundary.field_hi = pec pec pec
boundary.particle_lo = absorbing absorbing absorbing
boundary.particle_hi = absorbing absorbing absorbing

warpx.const_dt = 1.0e-12
warpx.use_filter = 0
algo.maxwell_solver = Yee

# Quadratic magnetization gives a linear analytic curl. Linear M would not
# distinguish the correct bracketing stencil from a one-cell-shifted stencil.
warpx.Mx_external_grid_function(x,y,z,t) = "y*y + 2.0*z*z"
warpx.My_external_grid_function(x,y,z,t) = "3.0*x*x + 4.0*z*z"
warpx.Mz_external_grid_function(x,y,z,t) = "5.0*x*x + 6.0*y*y"

diagnostics.diags_names = diag
diag.intervals = 1
diag.diag_type = Full
diag.format = plotfile
diag.fields_to_plot = jx jy jz
diag.plot_raw_fields = 1

# Verify that reduced diagnostics can select the exact external source, the
# solver-used plasma current, or their total without reconstructing J_ext.
warpx.reduced_diags_names = ExternalCurrentL2 PlasmaCurrentL2 TotalCurrentL2
ExternalCurrentL2.type = FieldReduction
ExternalCurrentL2.intervals = 1
ExternalCurrentL2.current_source = external
ExternalCurrentL2.reduction_type = Sum
ExternalCurrentL2.reduced_function(x,y,z,Ex,Ey,Ez,Bx,By,Bz,jx,jy,jz) = "(x>-3)*(x<3)*(y>-3)*(y<3)*(z>-3)*(z<3)*(jx*jx+jy*jy+jz*jz)"
PlasmaCurrentL2.type = FieldReduction
PlasmaCurrentL2.intervals = 1
PlasmaCurrentL2.current_source = plasma_used
PlasmaCurrentL2.reduction_type = Sum
PlasmaCurrentL2.reduced_function(x,y,z,Ex,Ey,Ez,Bx,By,Bz,jx,jy,jz) = "(x>-3)*(x<3)*(y>-3)*(y<3)*(z>-3)*(z<3)*(jx*jx+jy*jy+jz*jz)"
TotalCurrentL2.type = FieldReduction
TotalCurrentL2.intervals = 1
TotalCurrentL2.current_source = total
TotalCurrentL2.reduction_type = Sum
TotalCurrentL2.reduced_function(x,y,z,Ex,Ey,Ez,Bx,By,Bz,jx,jy,jz) = "(x>-3)*(x<3)*(y>-3)*(y<3)*(z>-3)*(z<3)*(jx*jx+jy*jy+jz*jz)"
