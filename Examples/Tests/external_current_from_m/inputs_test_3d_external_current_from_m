warpx.abort_on_warning_threshold = medium
warpx.serialize_initial_conditions = 1
warpx.do_dynamic_scheduling = 0
warpx.verbose = 0

max_step = 1
geometry.dims = 3
geometry.prob_lo = -4.0 -4.0 -4.0
geometry.prob_hi =  4.0  4.0  4.0
geometry.is_periodic = 0 0 0
amr.n_cell = 8 8 8
amr.max_grid_size = 4
amr.blocking_factor = 4
amr.max_level = 0

boundary.field_lo = pec pec pec
boundary.field_hi = pec pec pec
boundary.particle_lo = absorbing absorbing absorbing
boundary.particle_hi = absorbing absorbing absorbing

warpx.const_dt = 1.0e-12
warpx.use_filter = 0
algo.maxwell_solver = Yee

# Quadratic magnetization gives a linear analytic curl. Linear M would not
# distinguish the correct bracketing stencil from a one-cell-shifted stencil.
warpx.Mx_external_grid_function(x,y,z,t) = "y*y + 2.0*z*z"
warpx.My_external_grid_function(x,y,z,t) = "3.0*x*x + 4.0*z*z"
warpx.Mz_external_grid_function(x,y,z,t) = "5.0*x*x + 6.0*y*y"

diagnostics.diags_names = diag
diag.intervals = 1
diag.diag_type = Full
diag.format = plotfile
diag.fields_to_plot = jx jy jz
diag.plot_raw_fields = 1
