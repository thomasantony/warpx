+bool
+Device::canAccessPinnedHostMemory () noexcept
+{
+#if defined(AMREX_USE_CUDA)
+    static bool can_access = false;
+    static std::once_flag flag;
+    std::call_once(flag, [] () {
+        int can_map = 0;
+        if (cudaDeviceGetAttribute(&can_map, cudaDevAttrCanMapHostMemory,
+                                   Device::deviceId()) != cudaSuccess || !can_map) {
+            return;
+        }
+
+        void* host_ptr = nullptr;
+        if (cudaHostAlloc(&host_ptr, sizeof(void*), cudaHostAllocMapped) != cudaSuccess) {
+            return;
+        }
+
+        void* device_ptr = nullptr;
+        can_access = cudaHostGetDevicePointer(&device_ptr, host_ptr, 0) == cudaSuccess;
+        cudaFreeHost(host_ptr);
+    });
+    return can_access;
+#else
+    return true;
+#endif
+}
