+bool
+Device::canAccessPinnedHostMemory () noexcept
+{
+#if defined(AMREX_USE_CUDA)
+    static bool can_access = false;
+    static std::once_flag flag;
+    std::call_once(flag, [] () {
+        int can_map = 0;
+        if (cudaDeviceGetAttribute(&can_map, cudaDevAttrCanMapHostMemory,
+                                   Device::deviceId()) != cudaSuccess || !can_map) {
+            cudaGetLastError();
+            return;
+        }
+
+        void* host_ptr = nullptr;
+        if (cudaHostAlloc(&host_ptr, sizeof(void*), cudaHostAllocMapped) != cudaSuccess) {
+            cudaGetLastError();
+            return;
+        }
+
+        void* device_ptr = nullptr;
+        can_access = cudaHostGetDevicePointer(&device_ptr, host_ptr, 0) == cudaSuccess;
+        if (!can_access) { cudaGetLastError(); }
+        cudaFreeHost(host_ptr);
+    });
+    return can_access;
+#elif defined(AMREX_USE_HIP)
+    static bool can_access = false;
+    static std::once_flag flag;
+    std::call_once(flag, [] () {
+        int can_map = 0;
+        if (hipDeviceGetAttribute(&can_map, hipDeviceAttributeCanMapHostMemory,
+                                  Device::deviceId()) != hipSuccess || !can_map) {
+            hipGetLastError();
+            return;
+        }
+
+        void* host_ptr = nullptr;
+        if (hipHostMalloc(&host_ptr, sizeof(void*), hipHostMallocMapped) != hipSuccess) {
+            hipGetLastError();
+            return;
+        }
+
+        void* device_ptr = nullptr;
+        can_access = hipHostGetDevicePointer(&device_ptr, host_ptr, 0) == hipSuccess;
+        if (!can_access) { hipGetLastError(); }
+        hipHostFree(host_ptr);
+    });
+    return can_access;
+#else
+    return true;
+#endif
+}
