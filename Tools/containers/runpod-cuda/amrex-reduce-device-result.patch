+/**
+ * \brief Copy particle storage between a host tile and a device tile without
+ * launching a kernel that dereferences the host pointer.
+ */
+template <typename DstTile, typename SrcTile, typename CopyDirection,
+          std::integral Index, typename N>
+requires requires (DstTile& d, SrcTile const& s) {
+    d.GetStructOfArrays().GetIdCPUData();
+    s.GetStructOfArrays().GetIdCPUData();
+}
+void copyParticlesHostDevice (DstTile& dst, SrcTile const& src,
+                              Index src_start, Index dst_start, N n,
+                              CopyDirection direction) noexcept
+{
+    if (n == 0) { return; }
+
+    if constexpr (DstTile::ParticleType::is_soa_particle) {
+        auto& dst_idcpu = dst.GetStructOfArrays().GetIdCPUData();
+        auto const& src_idcpu = src.GetStructOfArrays().GetIdCPUData();
+        Gpu::copyAsync(direction, src_idcpu.begin() + src_start,
+                       src_idcpu.begin() + src_start + n,
+                       dst_idcpu.begin() + dst_start);
+    } else {
+        auto& dst_aos = dst.GetArrayOfStructs();
+        auto const& src_aos = src.GetArrayOfStructs();
+        Gpu::copyAsync(direction, src_aos.begin() + src_start,
+                       src_aos.begin() + src_start + n,
+                       dst_aos.begin() + dst_start);
+    }
+
+    auto& dst_soa = dst.GetStructOfArrays();
+    auto const& src_soa = src.GetStructOfArrays();
+    AMREX_ALWAYS_ASSERT(dst.NumRealComps() == src.NumRealComps());
+    AMREX_ALWAYS_ASSERT(dst.NumIntComps() == src.NumIntComps());
+    for (int comp = 0; comp < dst.NumRealComps(); ++comp) {
+        auto& dst_data = dst_soa.GetRealData(comp);
+        auto const& src_data = src_soa.GetRealData(comp);
+        Gpu::copyAsync(direction, src_data.begin() + src_start,
+                       src_data.begin() + src_start + n,
+                       dst_data.begin() + dst_start);
+    }
+    for (int comp = 0; comp < dst.NumIntComps(); ++comp) {
+        auto& dst_data = dst_soa.GetIntData(comp);
+        auto const& src_data = src_soa.GetIntData(comp);
+        Gpu::copyAsync(direction, src_data.begin() + src_start,
+                       src_data.begin() + src_start + n,
+                       dst_data.begin() + dst_start);
+    }
+    Gpu::streamSynchronize();
+}
