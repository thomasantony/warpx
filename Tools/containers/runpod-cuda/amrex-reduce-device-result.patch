+/**
+ * \brief Filter particles on the device and explicitly copy the selected
+ * particle storage to a pinned host destination.
+ */
+template <typename DstTile, typename SrcTile, typename Pred, typename Index, typename N>
+requires requires (DstTile& d, SrcTile& s) {
+    d.define(0, 0, nullptr, nullptr, The_Device_Arena());
+    s.define(0, 0, nullptr, nullptr, The_Device_Arena());
+    d.GetStructOfArrays().GetIdCPUData();
+    s.GetStructOfArrays().GetIdCPUData();
+}
+Index filterParticlesToHost (DstTile& dst, SrcTile const& src, Pred const& p,
+                             Index src_start, Index dst_start, N n) noexcept
+{
+    using DeviceDstTile = std::remove_cvref_t<DstTile>;
+    DeviceDstTile device_dst;
+    device_dst.define(dst.NumRuntimeRealComps(), dst.NumRuntimeIntComps(),
+                      nullptr, nullptr, The_Device_Arena());
+    device_dst.resize(n);
+
+    using DeviceSrcTile = std::remove_cvref_t<SrcTile>;
+    DeviceSrcTile device_src;
+    SrcTile const* source = &src;
+    Index device_src_start = src_start;
+    Arena* const src_arena = src.GetStructOfArrays().GetIdCPUData().arena();
+    if (src_arena->isPinned()) {
+        device_src.define(src.NumRuntimeRealComps(), src.NumRuntimeIntComps(),
+                          nullptr, nullptr, The_Device_Arena());
+        device_src.resize(n);
+        copyParticlesHostDevice(device_src, src, src_start, Index{0}, n,
+                                Gpu::hostToDevice);
+        source = &device_src;
+        device_src_start = Index{0};
+    }
+
+    Index const count = filterParticles(device_dst, *source, p,
+                                        device_src_start, Index{0}, n);
+    copyParticlesHostDevice(dst, device_dst, Index{0}, dst_start, count,
+                            Gpu::deviceToHost);
+    return count;
+}
